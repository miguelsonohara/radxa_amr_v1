[Unit]
Description=Receptionist Video Kiosk Loop
After=graphical.target display-manager.service gdm3.service
Wants=graphical.target

[Service]
Type=simple
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/receptionist_robot_ws
Environment=DISPLAY=:0
ExecStart=/home/radxa/receptionist_robot_ws/play_video_kiosk.sh
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=5

[Install]
WantedBy=graphical.target
