[Unit]
Description=Receptionist Video Kiosk Loop
After=graphical.target display-manager.service gdm3.service robot_bringup.service
Wants=graphical.target

[Service]
Type=simple
User=radxa
Group=radxa
WorkingDirectory=/home/radxa/receptionist_robot_ws
Environment=DISPLAY=:0
ExecStart=/home/radxa/receptionist_robot_ws/play_video_kiosk.sh
Restart=always
RestartSec=2
KillMode=mixed
TimeoutStopSec=5

# The kiosk must never preempt the Nav2 control loop or the micro-ROS serial
# reader. Confine it to the four little cores (capacity 382) and give it a
# token share, leaving the big/prime cores (4-7) to the robot stack.
CPUAffinity=0-3
CPUWeight=20
IOWeight=20
Nice=10

[Install]
WantedBy=graphical.target
