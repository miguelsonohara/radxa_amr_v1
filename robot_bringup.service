[Unit]
Description=Receptionist robot ROS 2 bringup (Nav2, SLAM, LiDAR, ESP32, camera, YOLO)
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/radxa/receptionist_robot_ws
ExecStart=/home/radxa/receptionist_robot_ws/start_robot_bringup.sh
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-bringup

# Control-loop latency comes first: outrank the kiosk and every other
# best-effort service so the micro-ROS serial reader is never preempted.
CPUWeight=10000
IOWeight=1000
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=multi-user.target
